# Copy to .env.local for development; set the same keys in Vercel → Settings → Environment Variables.

# Auth
SESSION_SECRET=            # 32+ random characters: openssl rand -base64 48
SETUP_TOKEN=               # one-time code to register your first passkey; remove or rotate afterwards
RP_ID=localhost            # production: houssem.dodor.nl
APP_ORIGIN=http://localhost:3000   # production: https://houssem.dodor.nl
AUTH_DEV_BYPASS=false      # true = skip login in `npm run dev` only (never works in production)

# Magic-link recovery (Resend, free tier)
OWNER_EMAIL=               # the only address a recovery link is ever sent to
RESEND_API_KEY=
MAIL_FROM=LifeOS <login@dodor.nl>

# Notion (internal integration, read-only access to both databases)
NOTION_TOKEN=
NOTION_BRIEFINGS_DS=4245cbad-13bf-81ba-be97-000b9e090693   # LifeOS Briefings data source
NOTION_TASKS_DS=1d85cbad-13bf-801d-a422-000b4a8d0294       # MyLife OS → Tasks data source

# Supabase (server only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
